     RowBox[{"Length", "[", "results", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testResult", " ", "=", " ", 
     RowBox[{"Position", "[", 
      RowBox[{"results", ",", " ", "\"\<A\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "testResult", "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"encodeResults", "[", "result_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "position", "}"}], ",", 
       RowBox[{
