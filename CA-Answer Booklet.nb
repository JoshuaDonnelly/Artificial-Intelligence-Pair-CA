          RowBox[{"First", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"results", ",", "result"}], "]"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "position"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultEncoded", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"encodeResults", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "6", "]"}], "]"}], "]"}], "&"}], ",", "originalData"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"originalData", "[", 
            RowBox[{"[", 
