           RowBox[{"encodeResults", "[", 
            RowBox[{"originalData", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "6"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<Date\>\"", ",", "\"\<Home Team\>\"", 
         ",", "\"\<Encoded Home Team\>\"", ",", "\"\<Away Team\>\"", 
