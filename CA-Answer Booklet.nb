Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"results", " ", "=", " ", 
     RowBox[{"Union", "[", "\[IndentingNewLine]", 
      RowBox[{"originalData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "  ", "6"}], "]"}], "]"}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"results", "=", 
     RowBox[{"DeleteCases", "[", 
      RowBox[{"results", ",", "\"\<FTR\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"resultMatrix", " ", "=", " ", 
    RowBox[{"IdentityMatrix", " ", "[", 
     RowBox[{"Length", "[", "results", "]"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testResult", " ", "=", " ", 
     RowBox[{"Position", "[", 
      RowBox[{"results", ",", " ", "\"\<A\>\""}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
