       RowBox[{"Equal", ",", 
        RowBox[{"{", 
         RowBox[{"trainingPredictions", ",", "resultEncoded"}], "}"}]}], 
       "]"}], ",", "True"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"accuracyOnTrainingData", "=", 
