            RowBox[{"originalData", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "3"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{"originalData", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "6"}], "]"}], "]"}], ",", 
