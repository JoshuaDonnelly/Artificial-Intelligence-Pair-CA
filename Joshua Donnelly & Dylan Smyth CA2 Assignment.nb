533c5d969a48"],

Cell[TextData[{
 "State how well the linear model performed and explain your reasoning.\n",
 StyleBox["Answer: ",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 1.]]
}], "Text",
 CellChangeTimes->{{3.8406077677898483`*^9, 3.8406077805787115`*^9}, {
   3.840607817148863*^9, 3.8406078233314943`*^9}, {3.840610140231086*^9, 
   3.8406101687976065`*^9}, {3.8406102722419147`*^9, 3.840610312311409*^9}, {
   3.840611453515895*^9, 3.8406115236670413`*^9}, {3.840611748504348*^9, 
   3.8406117564028687`*^9}, {3.8406198485685296`*^9, 3.840619894007408*^9}, {
   3.840620053998343*^9, 3.8406200554846*^9}, {3.840620190597066*^9, 
   3.8406201990693045`*^9}, {3.840621651922863*^9, 3.8406216608175735`*^9}, {
   3.840621727086878*^9, 3.840621727402832*^9}, 3.8406217713607407`*^9, {
   3.8406236275151677`*^9, 3.840623627877078*^9}, 3.8406236976897745`*^9, 
   4.004013723920439*^9},ExpressionUUID->"3feeb7a0-7517-467b-9c98-\
0acdbf0cc5e8"],

Cell["\<\
The linear regression model performed reasonably well overall. It was trained \
using 1,460 houses and 7 different features to predict house prices. The \
model achieved an R\.b2 value of 0.789 meaning it explained approximately 78% \
of the variation in house prices.

The model had a prediction error of around 38087 on the RMSE scale which is \
still quite a large amount when predicting house prices.

Overall, the model was able to identify a good relationship between the house \
features and their prices, but there is still room for improvement. These \
results were calculated using the training data, so testing the model on \
unseen data would give a better indication of how accurate it really is.
\
\>", "Text",
 CellChangeTimes->{{3.8406077657661633`*^9, 3.8406077988842287`*^9}, 
   4.004015389953026*^9, {4.0040154481951942`*^9, 4.0040154694558144`*^9}, {
   4.004015530356102*^9, 
   4.004015602072418*^9}},ExpressionUUID->"a7347ec0-eee8-4358-81d7-\
fd5363f94bf6"],

Cell["Code used to produce answer:\[LineSeparator]", "Text",
 CellChangeTimes->{{3.8406212671583977`*^9, 3.840621294907153*^9}, {
  3.840623759650882*^9, 3.8406237597957306`*^9}, {4.0040153301922665`*^9, 
  4.004015330721159*^9}},
 FontWeight->"Bold",
 FontColor->RGBColor[
  0., 0., 1.],ExpressionUUID->"5d30430c-0e64-4d70-920b-742710df8fc2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Predict", " ", "prices", " ", "for", " ", "the", " ", "training", " ", 
    "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"trainingPredictions", "=", 
     RowBox[{"x", ".", "theta"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "Mean", " ", "Squared", " ", "Error"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mse", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"y", "-", "trainingPredictions"}], ")"}], "^", "2"}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "Root", " ", "Mean", " ", "Squared", " ", "Error"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rmse", "=", 
     RowBox[{"Sqrt", "[", "mse", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "R", " ", "Squared"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rSquared", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", "trainingPredictions"}], ")"}], "^", "2"}], "]"}],
        "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"Mean", "[", "y", "]"}]}], ")"}], "^", "2"}], "]"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mean Squared Error: \>\"", ",", "mse"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Root Mean Squared Error: \>\"", ",", "rmse"}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<R Squared: \>\"", ",", "rSquared"}], "]"}], ";"}], "\[IndentingNewLine]", 
   InterpretationBox[
    RowBox[{"\"\<Mean Squared Error: \>\"", "\[InvisibleSpace]", 
     "1.450633935293605`*^9"}],
    SequenceForm["Mean Squared Error: ", 1.450633935293605*^9],
    Editable->False], "\n", 
   InterpretationBox[
    RowBox[{"\"\<Root Mean Squared Error: \>\"", "\[InvisibleSpace]", 
     "38087.18859792102`"}],
    SequenceForm["Root Mean Squared Error: ", 38087.18859792102],
    Editable->False], "\n", 
   InterpretationBox[
    RowBox[{"\"\<R Squared: \>\"", "\[InvisibleSpace]", 
     "0.7699884948318333`"}],
    SequenceForm["R Squared: ", 0.7699884948318333],
    Editable->False], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
  3.8406212739318576`*^9, 4.004015334786173*^9, {4.0040154051664696`*^9, 
   4.0040154068746204`*^9}},
 FontSize->16,ExpressionUUID->"3af426ab-4201-410c-9a3b-78c723b2444f"]
}, Open  ]],

