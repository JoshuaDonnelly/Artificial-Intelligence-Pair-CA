Cell[CellGroupData[{

Cell["Part 2. Replace missing values with mean", "Section",
 CellChangeTimes->{{4.003770405497865*^9, 
  4.0037704216935005`*^9}},ExpressionUUID->"5a85e0ad-f067-4431-a554-\
f4c21ac81d03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Clean", " ", "data"}], ",", " ", 
    RowBox[{
    "replace", " ", "missing", " ", "numerical", " ", "values", " ", "with", " ",
      "mean", " ", "for", " ", "the", " ", "particular", " ", "column"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"replaceWithMean", "[", "colData_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"meanNumber", ",", "numericData"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"numericData", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"colData", ",", 
           RowBox[{
            RowBox[{"NumberQ", "[", "#", "]"}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"If", " ", "the", " ", "column", " ", "is", " ", 
           RowBox[{"text", "/", "strings"}]}], ",", 
          RowBox[{"leave", " ", "it", " ", "completely", " ", "alone"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "numericData", "]"}], "\[Equal]", "0"}], ",",
           "colData", ",", 
          RowBox[{
           RowBox[{"meanNumber", "=", 
            RowBox[{"1.0", " ", 
             RowBox[{"Mean", "[", "numericData", "]"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"NumberQ", "[", "#", "]"}], ",", "#", ",", 
                "meanNumber"}], "]"}], "&"}], ",", "colData"}], "]"}]}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Apply", " ", "it", " ", "across", " ", "all", " ", "columns", " ", "of", 
     " ", "the", " ", "feature", " ", "matrix", " ", "x"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cleanedX", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Map", "[", "\[IndentingNewLine]", 
       RowBox[{"replaceWithMean", ",", "\[IndentingNewLine]", 
        RowBox[{"Transpose", "[", "x", "]"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "=", "cleanedX"}], ";"}]}]}]], "Input",ExpressionUUID->\
"77a42ff4-c95a-46da-9adc-46bf13a11eb4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part 3. Encode team names (hot-one matrices)", "Section",
 CellChangeTimes->{{4.0032091480995994`*^9, 4.0032092209063363`*^9}, {
  4.0037704455191183`*^9, 
  4.0037704456894655`*^9}},ExpressionUUID->"aa216020-cf20-42bd-a0cb-\
aa9a4d759d4b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"teams", "=", 
    RowBox[{"Union", "[", 
     RowBox[{
      RowBox[{"originalData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
      RowBox[{"originalData", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Teams vector length: \>\"", ",", 
     RowBox[{"Length", "[", "teams", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"teams", "=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{"teams", ",", 
      RowBox[{"\"\<AwayTeam\>\"", "|", "\"\<HomeTeam\>\""}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"test", " ", "=", " ", 
   RowBox[{"Position", "[", 
    RowBox[{"teams", ",", " ", "\"\<AwayTeam\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Testing for headers being present ->\>\"", ",", " ", "test"}],
    "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Position", "[", 
    RowBox[{"teams", ",", " ", "\"\<HomeTeam\>\""}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"teamMatrix", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", 
    RowBox[{"Length", "[", "teams", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"test", " ", "=", " ", 
   RowBox[{"Position", "[", 
    RowBox[{"teams", ",", " ", "\"\<Man United\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Position of Man United in identity matrix (where is the hot \
one?) : \>\"", ",", "test"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Print all teams, checking for headers within dataset ->\>\"", 
    ",", "teams"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"encodeTeam", "[", "team_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "position", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"position", "=", 
       RowBox[{"First", "[", 
        RowBox[{"First", "[", 
         RowBox[{"Position", "[", 
          RowBox[{"teams", ",", "team"}], "]"}], "]"}], "\[IndentingNewLine]",
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"teamMatrix", "[", 
       RowBox[{"[", "position", "]"}], "]"}]}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "A", " ", "function", " ", "to", " ", "encode", " ", "team", " ", "name", " ",
     "strings", " ", "into", " ", "an", " ", "Identity", " ", "matrix", " ", 
    "to", " ", "be", " ", "used", " ", "by", " ", "the", " ", "nn"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Rebuild", " ", "x", " ", "using", " ", "the", " ", "current", " ", 
    "filtered", " ", "dataset"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"#", "[", 
          RowBox[{"[", "3", "]"}], "]"}], ",", " ", "\[IndentingNewLine]", 
         RowBox[{"#", "[", 
          RowBox[{"[", "11", "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"#", "[", 
          RowBox[{"[", "12", "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"#", "[", 
          RowBox[{"[", "13", "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"#", "[", 
          RowBox[{"[", "14", "]"}], "]"}]}], "\[IndentingNewLine]", "}"}], 
       "\[IndentingNewLine]", "&"}], ",", "originalData"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Rebuild", " ", "m", " ", 
    RowBox[{"(", "length", ")"}], " ", "using", " ", "filtered", " ", 
    "data"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"Length", "[", "x", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xEncoded", " ", "=", " ", 
    RowBox[{"Map", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"encodeTeam", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"encodeTeam", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"#", "[", 
           RowBox[{"[", "4", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"#", "[", 
           RowBox[{"[", "5", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"#", "[", 
           RowBox[{"[", "6", "]"}], "]"}]}], "\[IndentingNewLine]", "}"}], 
        "]"}], " ", "&"}], ",", "\[IndentingNewLine]", "x"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Here", " ", "we", " ", "encode", " ", "all", " ", "teams", " ", "in", " ",
      "the", " ", "dataset"}], ",", " ", 
    RowBox[{
    "and", " ", "flatten", " ", "the", " ", "matrix", " ", "so", " ", "the", " ",
      "nn", " ", "can", " ", "use", " ", 
     RowBox[{"it", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Print", "[", 
    RowBox[{"xEncoded", "[", "1", "]"}], "]"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"originalData", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
       RowBox[{"encodeTeam", "[", 
        RowBox[{"originalData", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], "]"}], ",", 
       RowBox[{"originalData", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "3"}], "]"}], "]"}], ",", 
       RowBox[{"encodeTeam", "[", 
        RowBox[{"originalData", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "3"}], "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"originalData", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", " ", "6"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "10"}], "}"}]}], "]"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"3f12485f-0e09-4091-b7e7-916b6f6caece"],

