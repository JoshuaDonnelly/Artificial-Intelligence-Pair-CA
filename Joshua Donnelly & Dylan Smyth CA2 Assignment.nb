Cell[TextData[{
 "In this CA you are ",
 StyleBox["required",
  FontVariations->{"Underline"->True}],
 " to work in a team of two.\nYou should jointly answer all the questions \
(not divide them between you! ).\n  \nMake a copy of this file and rename it \
to be your names. \n\nFill your answer to each question (and how you found \
that answer) in the place provided directly underneath that question \
(otherwise it will not be marked).\n\nSave this file and upload it to moodle \
(only ",
 StyleBox["one student",
  FontVariations->{"Underline"->True}],
 " per team should upload it).\n    \nBoth students will be given the same \
mark. \n\nClearly highlight any work that was ",
 StyleBox["not directly created",
  FontVariations->{"Underline"->True}],
 " by the team e.g. use of ChatGPT."
}], "Section",
 CellChangeTimes->{{3.8087323460271473`*^9, 3.8087323526923227`*^9}, {
