Cell[TextData[{
 "State how well the linear model performed and explain your reasoning.\n",
 StyleBox["Answer: ",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 1.]]
}], "Text",
 CellChangeTimes->{{3.8406077677898483`*^9, 3.8406077805787115`*^9}, {
   3.840607817148863*^9, 3.8406078233314943`*^9}, {3.840610140231086*^9, 
   3.8406101687976065`*^9}, {3.8406102722419147`*^9, 3.840610312311409*^9}, {
   3.840611453515895*^9, 3.8406115236670413`*^9}, {3.840611748504348*^9, 
   3.8406117564028687`*^9}, {3.8406198485685296`*^9, 3.840619894007408*^9}, {
   3.840620053998343*^9, 3.8406200554846*^9}, {3.840620190597066*^9, 
   3.8406201990693045`*^9}, {3.840621651922863*^9, 3.8406216608175735`*^9}, {
   3.840621727086878*^9, 3.840621727402832*^9}, 3.8406217713607407`*^9, {
   3.8406236275151677`*^9, 3.840623627877078*^9}, 3.8406236976897745`*^9, 
   4.004013723920439*^9},ExpressionUUID->"3feeb7a0-7517-467b-9c98-\
0acdbf0cc5e8"],

Cell["\<\

The MSE measures the average squared difference between the actual and \
predicted house prices, while RMSE shows the typical prediction error in \
house price units. A lower value for both means the model is making more \
accurate predictions.

R\.b2 measures how much of the variation in house prices is explained by the \
model. A value closer to 1 indicates a better fit.

My model produced an RMSE of 33564.81060847241 and an R\.b2 value of \
0.8213676428286003. This suggests that the linear model  performed well , \
based on the size of the prediction errors and how much variation the model \
explains.\
\>", "Text",
 CellChangeTimes->{{3.8406077657661633`*^9, 3.8406077988842287`*^9}, 
   4.004015389953026*^9, {4.0040154481951942`*^9, 4.0040154694558144`*^9}, {
   4.004015530356102*^9, 4.004015602072418*^9}, 4.0044416378700323`*^9, 
   4.004443706846099*^9, 4.0044437443860703`*^9, 4.0044437760708876`*^9, {
   4.004443807429477*^9, 4.004443842471438*^9}, {4.0044438858817897`*^9, 
   4.004443891247024*^9}},
 FontSize:>Dynamic[
  0.041199999999999994` 
   FrontEnd`AbsoluteCurrentValue[{
     WindowSize, 1}]],ExpressionUUID->"a7347ec0-eee8-4358-81d7-fd5363f94bf6"],

Cell["Code used to produce answer:\[LineSeparator]", "Text",
 CellChangeTimes->{{3.8406212671583977`*^9, 3.840621294907153*^9}, {
  3.840623759650882*^9, 3.8406237597957306`*^9}, {4.0040153301922665`*^9, 
  4.004015330721159*^9}},
 FontWeight->"Bold",
 FontColor->RGBColor[
  0., 0., 1.],ExpressionUUID->"5d30430c-0e64-4d70-920b-742710df8fc2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linearPredictions", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"x", ".", "\[Theta]"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "errors"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearErrors", "=", 
    RowBox[{
     RowBox[{"Flatten", "[", "y", "]"}], "-", "linearPredictions"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "MSE"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearMSE", "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"linearErrors", "^", "2"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "RMSE"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearRMSE", "=", 
    RowBox[{"Sqrt", "[", "linearMSE", "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "R", " ", "Squared"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearR2", "=", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"linearErrors", "^", "2"}], "]"}], "/", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Flatten", "[", "y", "]"}], "-", 
          RowBox[{"Mean", "[", 
           RowBox[{"Flatten", "[", "y", "]"}], "]"}]}], ")"}], "^", "2"}], 
       "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Display", " ", "results"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<MSE: \>\"", ",", 
    RowBox[{"N", "[", "linearMSE", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<RMSE: \>\"", ",", 
    RowBox[{"N", "[", "linearRMSE", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<R Squared: \>\"", ",", 
    RowBox[{"N", "[", "linearR2", "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Answer", " ", "=", "\[IndentingNewLine]", 
  InterpretationBox[
   RowBox[{"\"\<MSE: \>\"", "\[InvisibleSpace]", "1.1265965111826224`*^9"}],
   SequenceForm["MSE: ", 1.1265965111826224`*^9],
   Editable->False]}], "\n", 
 InterpretationBox[
  RowBox[{"\"\<RMSE: \>\"", "\[InvisibleSpace]", "33564.81060847241`"}],
  SequenceForm["RMSE: ", 33564.81060847241],
  Editable->False], "\n", 
 InterpretationBox[
  RowBox[{"\"\<R Squared: \>\"", "\[InvisibleSpace]", "0.8213676428286003`"}],
  SequenceForm["R Squared: ", 0.8213676428286003],
  Editable->False]}], "Input",
 CellChangeTimes->{
  3.8406212739318576`*^9, 4.004015334786173*^9, {4.0040154051664696`*^9, 
   4.0040154068746204`*^9}, {4.004441643220498*^9, 4.0044416447284203`*^9}, {
   4.004443683695714*^9, 4.0044436953746424`*^9}, {4.004443747641841*^9, 
