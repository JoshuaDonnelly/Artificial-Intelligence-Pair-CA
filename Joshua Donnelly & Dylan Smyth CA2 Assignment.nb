Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Polynomial", " ", "Regression", " ", "using", " ", "Gradient", " ", 
    "Descent"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Use", " ", "existing", " ", "polynomial", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xPolyTrain", "=", 
     RowBox[{"N", "[", "xPolyTrain", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yPolyTrain", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"N", "[", "yPolyTrain", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"Length", "[", "yPolyTrain", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Cost", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polyCost", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"xPolyTrain", ".", "t"}], "-", "yPolyTrain"}], ")"}], "^", 
        "2"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "m"}], ")"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", "Gradient", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polyGradient", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "xPolyTrain", "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"xPolyTrain", ".", "t"}], "-", "yPolyTrain"}], ")"}]}], "/", 
      "m"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaPoly", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "xPolyTrain", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Settings", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaPoly", "=", "0.01"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tolerance", "=", "0.000001"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxIterations", "=", "1000"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"oldCost", "=", 
     RowBox[{"polyCost", "[", "thetaPoly", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"iteration", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"converged", "=", "False"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Gradient", " ", "Descent"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"iteration", "<", "maxIterations"}], "&&", 
       RowBox[{"!", "converged"}]}], ",", 
      RowBox[{
       RowBox[{"gradient", "=", 
        RowBox[{"polyGradient", "[", "thetaPoly", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"newTheta", "=", 
        RowBox[{"thetaPoly", "-", 
         RowBox[{"alphaPoly", " ", "gradient"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"newCost", "=", 
        RowBox[{"polyCost", "[", "newTheta", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Reduce", " ", "learning", " ", "rate", " ", "if", " ", "cost", " ", 
         "increases"}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"newCost", ">", "oldCost"}], ",", 
         RowBox[{"alphaPoly", "=", 
          RowBox[{"alphaPoly", "/", "2"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{"Accept", " ", "the", " ", "new", " ", "parameters"}], 
          "*)"}], 
         RowBox[{
          RowBox[{"improvement", "=", 
           RowBox[{"oldCost", "-", "newCost"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"thetaPoly", "=", "newTheta"}], ";", "\[IndentingNewLine]", 
          RowBox[{"iteration", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "improvement", "]"}], "<", "tolerance"}], 
            ",", 
            RowBox[{"converged", "=", "True"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"oldCost", "=", "newCost"}], ";"}]}], "]"}], ";"}]}], "]"}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Iterations used: \>\"", ",", "iteration"}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Converged: \>\"", ",", "converged"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Final learning rate: \>\"", ",", "alphaPoly"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Final cost: \>\"", ",", 
      RowBox[{"polyCost", "[", "thetaPoly", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of parameters: \>\"", ",", 
      RowBox[{"Length", "[", "thetaPoly", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Polynomial parameters: \>\"", ",", "thetaPoly"}], "]"}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
  3.8406212739318576`*^9, 4.004194910443884*^9, {4.0041950467954903`*^9, 
   4.0041950602370358`*^9}, {4.004196332315016*^9, 4.004196412170168*^9}, 
   4.0044416583806033`*^9, 4.00445036183902*^9, 4.004469270689497*^9},
 FontSize:>Dynamic[
  0.028999999999999998` 
   FrontEnd`AbsoluteCurrentValue[{
     WindowSize, 1}]],ExpressionUUID->"b464a654-45b3-4271-908a-2c7d8655a2c5"]
}, Open  ]],

