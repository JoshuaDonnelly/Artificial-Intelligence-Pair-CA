  FontWeight->"Bold",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]]
}], "Subsection",
 CellChangeTimes->{{3.8087334418183565`*^9, 3.8087334484885187`*^9}, {
   3.840623522414098*^9, 3.8406235285115347`*^9}, {3.840623567291004*^9, 
