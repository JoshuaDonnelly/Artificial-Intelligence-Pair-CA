 FontWeight->"Bold",
 FontColor->RGBColor[
  0., 0., 1.],ExpressionUUID->"9af1e54b-3b2f-486e-8c0e-2bfa9a62276b"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(*", 
    RowBox[{
    "Use", " ", "the", " ", "same", " ", "validation", " ", "houses", " ", 
     "for", " ", "both", " ", "models"}], "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"xLinearValidation", "=", 
      RowBox[{"Take", "[", 
       RowBox[{"x", ",", 
        RowBox[{"-", 
         RowBox[{"Length", "[", "yPolyValidation", "]"}]}]}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{
     "Linear", " ", "model", " ", "predictions", " ", "from", " ", "Question",
       " ", "2"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"linearValidationPredictions", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"xLinearValidation", ".", "\[Theta]"}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{"Non", "-", 
      RowBox[{
      "linear", " ", "model", " ", "predictions", " ", "from", " ", 
       "Question", " ", "6"}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"polyValidationPredictions", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"N", "[", "xPolyValidation", "]"}], ".", "thetaPoly"}], 
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{"Actual", " ", "house", " ", "prices"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"actualPrices", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"N", "[", "yPolyValidation", "]"}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{"Calculate", " ", "errors"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"linearErrors8", "=", 
      RowBox[{"actualPrices", "-", "linearValidationPredictions"}]}], ";"}], 
    "\n", 
    RowBox[{
     RowBox[{"polyErrors8", "=", 
      RowBox[{"actualPrices", "-", "polyValidationPredictions"}]}], ";"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Calculate", " ", "MSE"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"linearMSE", "=", 
      RowBox[{"Mean", "[", 
       RowBox[{"linearErrors8", "^", "2"}], "]"}]}], ";"}], "\n", 
    RowBox[{
     RowBox[{"polyMSE", "=", 
      RowBox[{"Mean", "[", 
       RowBox[{"polyErrors8", "^", "2"}], "]"}]}], ";"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Calculate", " ", "RMSE"}], "*)"}], "\n", 
    RowBox[{
     RowBox[{"linearRMSE8", "=", 
      RowBox[{"Sqrt", "[", "linearMSE", "]"}]}], ";"}], "\n", 
    RowBox[{
     RowBox[{"polyRMSE8", "=", 
      RowBox[{"Sqrt", "[", "polyMSE", "]"}]}], ";"}], "\[IndentingNewLine]", 
    "\n", 
    RowBox[{"(*", 
     RowBox[{"Calculate", " ", "R", " ", "Squared"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"linearR2", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"linearErrors8", "^", "2"}], "]"}], "/", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"actualPrices", "-", 
            RowBox[{"Mean", "[", "actualPrices", "]"}]}], ")"}], "^", "2"}], 
         "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
    RowBox[{
     RowBox[{"polyR2", "=", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"polyErrors8", "^", "2"}], "]"}], "/", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"actualPrices", "-", 
            RowBox[{"Mean", "[", "actualPrices", "]"}]}], ")"}], "^", "2"}], 
         "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{"Display", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Linear MSE: \>\"", ",", 
       RowBox[{"N", "[", "linearMSE", "]"}]}], "]"}], ";"}], "\n", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Linear RMSE: \>\"", ",", 
       RowBox[{"N", "[", "linearRMSE", "]"}]}], "]"}], ";"}], "\n", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Linear R Squared: \>\"", ",", 
       RowBox[{"N", "[", "linearR2", "]"}]}], "]"}], ";"}], "\n", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Non-Linear MSE: \>\"", ",", 
       RowBox[{"N", "[", "polyMSE", "]"}]}], "]"}], ";"}], "\n", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Non-Linear RMSE: \>\"", ",", 
       RowBox[{"N", "[", "polyRMSE", "]"}]}], "]"}], ";"}], "\n", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Non-Linear R Squared: \>\"", ",", 
       RowBox[{"N", "[", "polyR2", "]"}]}], "]"}], ";"}]}]}],
  FontSize:>Dynamic[
   0.024 FrontEnd`AbsoluteCurrentValue[{WindowSize, 1}]]]], "Input",
