   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trainedNet", "=", 
     RowBox[{"NetTrain", "[", 
      RowBox[{"net", ",", "trainingPairs"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{4.003669599744321*^9, 4.0036696082078547`*^9}, {
