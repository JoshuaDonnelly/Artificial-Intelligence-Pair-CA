Cell[TextData[{
 "Using the non-linear Regression model created - predict the house prices \
for the houses with IDs from 1461 to 2919.\n",
 StyleBox["Answer:",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 1.]]
}], "Text",
 CellChangeTimes->{{3.8406077677898483`*^9, 3.8406077805787115`*^9}, {
   3.840607817148863*^9, 3.8406078375778275`*^9}, {3.840610069305292*^9, 
   3.840610134078578*^9}, {3.8406102145362997`*^9, 3.840610233887953*^9}, {
   3.8406104711352663`*^9, 3.840610471195808*^9}, {3.840611544571762*^9, 
   3.840611544609676*^9}, {3.840619931532981*^9, 3.8406199503229513`*^9}, {
   3.840620074843757*^9, 3.8406200787394524`*^9}, {3.8406202082757907`*^9, 
   3.840620208314365*^9}, {3.840623650920128*^9, 3.8406236512518005`*^9}, 
   3.8406237017160354`*^9, {3.94127154751047*^9, 
   3.9412715554045515`*^9}},ExpressionUUID->"d61e793d-2cc3-479b-af73-\
d7cf46ea0fb1"],

Cell["\<\
We normalize the features using the mean and standard deviation from the \
training data and created the polynomial features by adding their squared \
values.
The parameters are from questions 6\[CloseCurlyQuote]s gradient decent which \
were used to predict the house prices. This was done by multiplying the \
polynomial features by the model parameters.
The predicted prices were then displayed in a table alongside their \
corresponding house IDs.
\
\>", "Text",
 CellChangeTimes->{{3.8406077657661633`*^9, 3.8406077988842287`*^9}, {
  4.004197696146511*^9, 4.0041978647183228`*^9}, {4.0041979008582954`*^9, 
  4.0041979012830048`*^9}, {4.0041991479916496`*^9, 
  4.004199153721525*^9}},ExpressionUUID->"262510eb-dd2d-4a05-a9b5-\
90c83b176bc6"],

Cell["Code used to produce answer:", "Text",
 CellChangeTimes->{{3.8406212671583977`*^9, 3.840621294907153*^9}, {
  3.840623759650882*^9, 3.8406237597957306`*^9}},
 FontWeight->"Bold",
 FontColor->RGBColor[
  0., 0., 1.],ExpressionUUID->"c3fca821-1976-4a13-bdad-dd3869d4e79c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Select", " ", "the", " ", "same", " ", "features", " ", "as", " ", 
    "Question", " ", "5"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"testColumns", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"testHeaders", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
      "featureNames"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNew", "=", 
     RowBox[{"N", "[", 
      RowBox[{"testRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"Flatten", "[", "testColumns", "]"}]}], "]"}], "]"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Normalize", " ", "using", " ", "Question", " ", "5", " ", "training", " ",
      "values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNewScaled", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", "featureMeans"}], ")"}], "/", "featureSDs"}], 
        "&"}], ",", "xNew"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "polynomial", " ", "features"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNewPoly", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"#", ",", 
            RowBox[{"#", "^", "2"}]}], "]"}], ",", "1"}], "]"}], "&"}], ",", 
       "xNewScaled"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Predict", " ", "using", " ", "Gradient", " ", "Descent", " ", 
     "parameters"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "regression", " ", "hypothesis"}], 
    "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"xInput_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"xInput", ".", "t"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Predict", " ", "house", " ", "prices"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"predictedPrices", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{"#", ",", "thetaGD"}], "]"}], "&"}], ",", "xNewPoly"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Get", " ", "house", " ", "IDs"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"idColumn", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"testHeaders", ",", "\"\<Id\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"houseIDs", "=", 
     RowBox[{"testRows", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "idColumn"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "predictions"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"resultsQ7", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"houseIDs", ",", "predictedPrices"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of predictions: \>\"", ",", 
      RowBox[{"Length", "[", "predictedPrices", "]"}]}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{"resultsQ7", ",", "20"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<House ID\>\"", ",", "\"\<Predicted Price\>\""}], "}"}]}],
       "]"}], ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   TagBox[GridBox[{
      {"\"\<House ID\>\"", "\"\<Predicted Price\>\""},
      {"1461", "110455.98591634873`"},
      {"1462", "162731.7688246067`"},
      {"1463", "162492.64798335813`"},
      {"1464", "175548.87074545794`"},
      {"1465", "228398.8562461241`"},
      {"1466", "168953.95282777067`"},
      {"1467", "162893.5762720113`"},
      {"1468", "161331.96542440896`"},
      {"1469", "206362.49817408033`"},
      {"1470", "117505.80180000792`"},
      {"1471", "204401.95837257488`"},
      {"1472", "110567.25177715952`"},
      {"1473", "103765.31744022809`"},
      {"1474", "157346.38860959883`"},
      {"1475", "148237.04521844728`"},
      {"1476", "359746.8998899742`"},
      {"1477", "269437.8639824939`"},
      {"1478", "323468.6705959732`"},
      {"1479", "290719.603844131`"},
      {"1480", "400272.94963523897`"}
     },
     AutoDelete->False,
     GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
    "Grid"], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
  3.8406212739318576`*^9, {4.0041971064323616`*^9, 4.0041971258784294`*^9}, {
   4.0041976851254864`*^9, 
   4.004197687747719*^9}},ExpressionUUID->"b6b5388b-b46c-4ff6-82e2-\
fc82f5c715d4"]
}, Open  ]],

