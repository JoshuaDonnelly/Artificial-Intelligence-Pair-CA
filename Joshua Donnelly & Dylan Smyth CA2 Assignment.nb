Cell[CellGroupData[{

Cell["\<\
Prepare test data, to get an idea of how well our nn is doing\
\>", "Section",
 CellChangeTimes->{{4.003680940082755*^9, 4.0036809461790323`*^9}, {
   4.0036809912507524`*^9, 4.003681002075246*^9}, 
   4.003681076293783*^9},ExpressionUUID->"8f94e43c-13be-43ff-bb65-\
b9755583f0d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testData", " ", "=", " ", 
   RowBox[{
   "Import", 
    "[", "\"\<C:\\\\Users\\\\joshu\\\\Desktop\\\\Year 4\\\\Data for AI \
CA2\\\\season-2526.csv\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testData", " ", "=", " ", 
   RowBox[{"Rest", "[", "testData", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"teamsToKeep", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Man United\>\"", ",", "\"\<Liverpool\>\"", 
      ",", "\"\<Man City\>\"", ",", "\"\<Arsenal\>\""}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testData", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"testData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"teamsToKeep", ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&&", 
        RowBox[{"MemberQ", "[", 
         RowBox[{"teamsToKeep", ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "&"}]}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"testX", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "\[IndentingNewLine]", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"encodeTeam", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"encodeTeam", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"#", "[", 
           RowBox[{"[", "11", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"#", "[", 
           RowBox[{"[", "12", "]"}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"#", "[", 
           RowBox[{"[", "13", "]"}], "]"}], ",", 
          RowBox[{"#", "\[IndentingNewLine]", "[", 
           RowBox[{"[", "14", "]"}], "]"}]}], "}"}], "]"}], 
       "\[IndentingNewLine]", "&"}], ",", "testData"}], "\[IndentingNewLine]",
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testResultEncoded", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"encodeResults", "[", 
       RowBox[{"#", "[", 
        RowBox[{"[", "6", "]"}], "]"}], "]"}], "&"}], ",", "testData"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0036810197641706`*^9, 
  4.0036810681438627`*^9}},ExpressionUUID->"089d4530-8180-45dc-9024-\
08aac8063ef5"]
}, Open  ]],

