Cell[TextData[{
 "State the features you extracted/generated from the data and how they were \
calculated as well as how you split the data up prior to training the Neural \
Network.\ni.e. display a sample of 10 records from each of the datasets (and \
state how many examples there are in total) you used in generating the Neural \
Network .\n",
 StyleBox["Answer:",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 1.]]
}], "Text",
 CellChangeTimes->{{3.840607725384644*^9, 3.840607760872209*^9}, {
   3.8406078022778606`*^9, 3.8406078102046776`*^9}, {3.8406106963508224`*^9, 
   3.8406107088405824`*^9}, {3.8406109923753786`*^9, 3.840611013098338*^9}, {
   3.8406110693175955`*^9, 3.8406111194349594`*^9}, {3.840619531338698*^9, 
   3.8406196000348096`*^9}, {3.840620019754721*^9, 3.8406200231767826`*^9}, {
   3.840620153516815*^9, 3.8406201535701885`*^9}, {3.84062096077177*^9, 
   3.840620982907363*^9}, {3.840621944987389*^9, 3.8406219678998766`*^9}, {
   3.840622303353545*^9, 3.8406223553882604`*^9}, 3.840622556881044*^9, {
   3.8406248249090548`*^9, 3.8406248255704236`*^9}, 3.8406252575298567`*^9, {
   3.840625307740189*^9, 3.84062530848371*^9}, {3.8474369250864387`*^9, 
   3.847436950420021*^9}, {3.8474371145929317`*^9, 3.847437147374682*^9}, {
   3.9036812510575633`*^9, 3.9036812574270697`*^9}, {3.9036812971883245`*^9, 
   3.903681370783835*^9}, {3.999319750848702*^9, 
   3.9993197596303*^9}},ExpressionUUID->"64e92d9d-0637-45d2-88fc-\
417951aaebf0"],

Cell["\<\
1. Firstly we split the data from the headers using Rest
2. Then we only keep the results from the \[OpenCurlyDoubleQuote]conventional\
\[CloseCurlyDoubleQuote] top 4 teams to reduce the amount of data.
3. We cleaned the data by replacing missing numerical values with the mean
3. We had to transform the team names to be used as an input to our neural \
network. We used encoding team names into a one-hot identity matrix
4. And filter only the 2, 3, 11, 12, 13, 14 rows from the original excel \
sheets. This included Home team, Away team, Home shots, Away shots, Home \
shots On Target, Away shots On Target and Full time result
4. Then we had to encode the full time results (our predictor) 
5. Finally, we had to convert our data into \
\[OpenCurlyDoubleQuote]trainingPairs\[CloseCurlyDoubleQuote] with our inputs \
threaded to our outputs. This is because the functions (netTrain) Mathematica \
use expect our data to be formatted as pairs
\
\>", "Text",
 CellChangeTimes->{{3.8406077657661633`*^9, 3.8406077988842287`*^9}, {
   3.8406248407328467`*^9, 3.8406248433065586`*^9}, {4.000038200275921*^9, 
   4.0000382753155627`*^9}, 4.0000383150291986`*^9, {4.00368023138135*^9, 
   4.0036804053791885`*^9}, {4.0036804680811453`*^9, 
   4.0036805451318626`*^9}, {4.0036806776388273`*^9, 4.003680703384271*^9}, {
   4.003680760194358*^9, 4.003680851333223*^9}, {4.003770375051532*^9, 
   4.0037703929985733`*^9}},ExpressionUUID->"47021a2d-2a3e-484e-bd10-\
ff8ce41848a7"],

Cell["Code used to produce answer:", "Text",
 CellChangeTimes->{{3.8406212671583977`*^9, 3.840621294907153*^9}, {
  3.840623759650882*^9, 3.8406237597957306`*^9}},
 FontWeight->"Bold",
 FontColor->RGBColor[
  0., 0., 1.],ExpressionUUID->"0b16dead-e230-4422-9a18-114d3ce94eed"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Part 1. Keep only the \[OpenCurlyDoubleQuote]conventional\
\[CloseCurlyDoubleQuote] top 4 teams", "Section",
 CellChangeTimes->{
  3.8406212739318576`*^9, {4.0000383447048216`*^9, 4.0000383825906863`*^9}, {
   4.0032090504273043`*^9, 
   4.0032090646536827`*^9}},ExpressionUUID->"77bc48bf-8d88-48dc-b03e-\
a30be7eca813"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"teamsToKeep", "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Man United\>\"", ",", "\"\<Liverpool\>\"", 
      ",", "\"\<Man City\>\"", ",", "\"\<Arsenal\>\""}], "}"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalData", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Rest", "[", "originalData", "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"teamsToKeep", ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&&", 
        RowBox[{"MemberQ", "[", 
         RowBox[{"teamsToKeep", ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "&"}]}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", "originalData", "]"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.8406212739318576`*^9, {4.0000383447048216`*^9, 4.0000383572328463`*^9}, {
   4.003209076556098*^9, 4.0032090909012012`*^9}, {4.0032091264410615`*^9, 
   4.003209127519112*^9}},ExpressionUUID->"4cc376ae-0f8a-4ddb-92dc-\
c4af8f9b01e7"],

