Cell[TextData[{
 "Using Linear Regression predict the house prices for the houses with IDs \
from 1461 to 2919 (found in test.csv)\nsample answer: { {id, price}, {1461, \
239344.34}, {1462, 94383.35},...{2919, 489033.44}}\n",
 StyleBox["Answer: ",
  FontWeight->"Bold",
  FontColor->RGBColor[0., 0., 1.]]
}], "Text",
 CellChangeTimes->{{3.8406077677898483`*^9, 3.8406077805787115`*^9}, {
   3.840607817148863*^9, 3.8406078375778275`*^9}, {3.840610069305292*^9, 
   3.840610134078578*^9}, {3.8406103445294485`*^9, 3.8406104294046173`*^9}, {
   3.8406114067682934`*^9, 3.840611406843758*^9}, {3.8406197539130535`*^9, 
   3.840619754223263*^9}, {3.8406200491000996`*^9, 3.840620050676186*^9}, {
   3.8406201694596577`*^9, 3.8406201750266476`*^9}, {3.84062361295474*^9, 
   3.8406236132858353`*^9}, 3.8406236961390038`*^9, {4.0040135109723816`*^9, 
   4.0040135120225277`*^9}, 
   4.004015348881384*^9},ExpressionUUID->"1c085178-a7a0-4047-8956-\
0a0a38ae4141"],

Cell["\<\
We use Multivariate Linear Regression to predict the house prices for the \
1460 houses in the test dataset using 7 different house features . The model \
was trained on 1460 houses and then used to predict the prices of the houses \
with IDs from 1461 to 2919. The first 10 predicted prices are shown above, \
ranging from 103000 to 222564.\
\>", "Text",
 CellChangeTimes->{
  3.8406104511165066`*^9, 4.0040153505845795`*^9, {4.004091848978588*^9, 
   4.004091853231327*^9}, {4.0040919401718254`*^9, 4.0040920050510464`*^9}, {
   4.004092154151022*^9, 
   4.00409218876108*^9}},ExpressionUUID->"5b5d3a00-5e7b-4b90-ad3c-\
e5d910030b42"],

