Cell[TextData[{
 "Code used to produce answer:\[LineSeparator]",
 StyleBox["predictedPrices=Flatten[x.\[Theta]];\n\n(*Round predictions to 2 \
decimal places*)\npredictedPrices=Round[#,0.01]&/@predictedPrices;\n\n\
(*Create house IDs*)\nids=Range[1461,2919];\n\n(*Combine IDs and predicted \
prices*)\nanswer=Prepend[Transpose[{ids,predictedPrices}],{\
\[OpenCurlyDoubleQuote]id\[CloseCurlyDoubleQuote],\[CloseCurlyDoubleQuote]\
price\[CloseCurlyDoubleQuote]}];\n\n(*Display answer*)\nanswer",
  FontColor->GrayLevel[0]]
}], "Text",
