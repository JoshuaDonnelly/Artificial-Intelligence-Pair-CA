Cell[TextData[{
 "This data was found online, whilst researching appropriate datasets, that \
held premier league results with 3 outputs (Home, Draw, Away) and contained \
data up to and including the 25/26 campaign. The website is also great for \
getting more data on previous seasons to adjust our neural network.\nAmount \
of examples: 106 matches over 10 premier league seasons.\n\nWebsite -> \
https://datahub.io/football/english-premier-league\n\n",
 Cell[BoxData[
  RowBox[{"\<\"Sample: \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {"\<\"04/09/2022\"\>", "\<\"Man United\"\>", "\<\"Arsenal\"\>", "3", 
