Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linearPredictions", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"x", ".", "\[Theta]"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "errors"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearErrors", "=", 
    RowBox[{
     RowBox[{"Flatten", "[", "y", "]"}], "-", "linearPredictions"}]}], ";"}], 
  "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "MSE"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearMSE", "=", 
    RowBox[{"Mean", "[", 
     RowBox[{"linearErrors", "^", "2"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "RMSE"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearRMSE", "=", 
    RowBox[{"Sqrt", "[", "linearMSE", "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Calculate", " ", "R", " ", "Squared"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearR2", "=", 
    RowBox[{"1", "-", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"linearErrors", "^", "2"}], "]"}], "/", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Flatten", "[", "y", "]"}], "-", 
          RowBox[{"Mean", "[", 
           RowBox[{"Flatten", "[", "y", "]"}], "]"}]}], ")"}], "^", "2"}], 
       "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Display", " ", "results"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<MSE: \>\"", ",", 
    RowBox[{"N", "[", "linearMSE", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<RMSE: \>\"", ",", 
    RowBox[{"N", "[", "linearRMSE", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<R Squared: \>\"", ",", 
    RowBox[{"N", "[", "linearR2", "]"}]}], "]"}], ";"}], "\n"}], "Input",
