Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Question", " ", "8"}], "-", 
    RowBox[{"Compare", " ", "Linear", " ", "and", " ", "Non"}], "-", 
    RowBox[{"Linear", " ", "Regression"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Train", " ", "linear", " ", "regression", " ", "on", " ", "the", " ", 
    "same", " ", "training", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xTrainLinear", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "xTrainScaled"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xTestLinear", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "xTestScaled"}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaLinear", "=", 
     RowBox[{"LeastSquares", "[", 
      RowBox[{"xTrainLinear", ",", "yTrain"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Predict", " ", "house", " ", "prices"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"predictionsLinear", "=", 
     RowBox[{"xTestLinear", ".", "thetaLinear"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"predictionsPoly", "=", 
     RowBox[{"xTestPoly", ".", "thetaPoly"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "Linear", " ", "Regression", " ", "performance"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"mseLinear", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"yTest", "-", "predictionsLinear"}], ")"}], "^", "2"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rmseLinear", "=", 
     RowBox[{"Sqrt", "[", "mseLinear", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rSquaredLinear", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"yTest", "-", "predictionsLinear"}], ")"}], "^", "2"}], 
        "]"}], "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"yTest", "-", 
           RowBox[{"Mean", "[", "yTest", "]"}]}], ")"}], "^", "2"}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "Polynomial", " ", "Regression", " ", "performance"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"msePoly", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"yTest", "-", "predictionsPoly"}], ")"}], "^", "2"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"rmsePoly", "=", 
     RowBox[{"Sqrt", "[", "msePoly", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rSquaredPoly", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"yTest", "-", "predictionsPoly"}], ")"}], "^", "2"}], "]"}],
        "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"yTest", "-", 
           RowBox[{"Mean", "[", "yTest", "]"}]}], ")"}], "^", "2"}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "results"}], "*)"}], "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<Metric\>\"", ",", "\"\<Linear Regression\>\"", 
         ",", "\"\<Polynomial Regression\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<MSE\>\"", ",", "mseLinear", ",", "msePoly"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<RMSE\>\"", ",", "rmseLinear", ",", "rmsePoly"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<R Squared\>\"", ",", "rSquaredLinear", ",", 
         "rSquaredPoly"}], "}"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Compare", " ", "actual", " ", "and", " ", "predicted", " ", "prices"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"yTest", ",", "predictionsLinear"}], "}"}], "]"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"yTest", ",", "predictionsPoly"}], "}"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Linear Regression\>\"", 
          ",", "\"\<Polynomial Regression\>\""}], "}"}]}], ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Actual Price\>\"", ",", "\"\<Predicted Price\>\""}], 
         "}"}]}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Linear vs Polynomial Regression\>\""}],
        ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{"x", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Min", "[", "yTest", "]"}], ",", 
         RowBox[{"Max", "[", "yTest", "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Red", "}"}]}]}], "]"}]}], "]"}], "\n"}]}]], "Input",
