Cell["Question 5", "Text",
 CellChangeTimes->{{4.0040936851247673`*^9, 
  4.0040936882141953`*^9}},ExpressionUUID->"e9f0c02f-04c1-1244-ad82-\
07f33c975887"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Rebuild", " ", "the", " ", "input", " ", "and", " ", "output", " ", 
    "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"featureNames", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<OverallQual\>\"", ",", "\"\<GrLivArea\>\"", 
       ",", "\"\<GarageCars\>\"", ",", "\"\<TotalBsmtSF\>\"", 
       ",", "\"\<FullBath\>\"", ",", "\"\<YearBuilt\>\"", 
       ",", "\"\<1stFlrSF\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"headers", "=", 
     RowBox[{"First", "[", "originalData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dataRows", "=", 
     RowBox[{"Rest", "[", "originalData", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"featureColumns", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"headers", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
      "featureNames"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"priceColumn", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"headers", ",", "\"\<SalePrice\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"xAll", "=", 
     RowBox[{"N", "[", 
      RowBox[{"dataRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"Flatten", "[", "featureColumns", "]"}]}], "]"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{"N", "[", 
      RowBox[{"dataRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "priceColumn"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<xAll dimensions: \>\"", ",", 
      RowBox[{"Dimensions", "[", "xAll", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<y dimensions: \>\"", ",", 
      RowBox[{"Dimensions", "[", "y", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Question", " ", "5"}], "-", "Non", "-", 
     RowBox[{"Linear", " ", "Polynomial", " ", "Regression"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
    "Split", " ", "data", " ", "into", " ", "80", "%", " ", "training", " ", 
     "and", " ", "20", "%", " ", "testing"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"Length", "[", "xAll", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"indices", "=", 
     RowBox[{"RandomSample", "[", 
      RowBox[{"Range", "[", "m", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"split", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{"0.8", "*", "m"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trainIndices", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"indices", ",", "split"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"testIndices", "=", 
     RowBox[{"Drop", "[", 
      RowBox[{"indices", ",", "split"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xTrainRaw", "=", 
     RowBox[{"xAll", "[", 
      RowBox[{"[", "trainIndices", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"xTestRaw", "=", 
     RowBox[{"xAll", "[", 
      RowBox[{"[", "testIndices", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yTrain", "=", 
     RowBox[{"y", "[", 
      RowBox[{"[", "trainIndices", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yTest", "=", 
     RowBox[{"y", "[", 
      RowBox[{"[", "testIndices", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Normalize", " ", "using", " ", "training", " ", "data"}], "*)"}],
    "\n", 
   RowBox[{
    RowBox[{"featureMeans", "=", 
     RowBox[{"Mean", "/@", 
      RowBox[{"Transpose", "[", "xTrainRaw", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"featureSDs", "=", 
     RowBox[{"StandardDeviation", "/@", 
      RowBox[{"Transpose", "[", "xTrainRaw", "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xTrainScaled", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", "featureMeans"}], ")"}], "/", "featureSDs"}], 
        "&"}], ",", "xTrainRaw"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xTestScaled", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", "featureMeans"}], ")"}], "/", "featureSDs"}], 
        "&"}], ",", "xTestRaw"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "polynomial", " ", "features"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"xTrainPoly", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"#", ",", 
            RowBox[{"#", "^", "2"}]}], "]"}], ",", "1"}], "]"}], "&"}], ",", 
       "xTrainScaled"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xTestPoly", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"#", ",", 
            RowBox[{"#", "^", "2"}]}], "]"}], ",", "1"}], "]"}], "&"}], ",", 
       "xTestScaled"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Train", " ", "the", " ", "non"}], "-", 
     RowBox[{"linear", " ", "model"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"thetaPoly", "=", 
     RowBox[{"LeastSquares", "[", 
      RowBox[{"xTrainPoly", ",", "yTrain"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Predict", " ", "test", " ", "house", " ", "prices"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"predictionsPoly", "=", 
     RowBox[{"xTestPoly", ".", "thetaPoly"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Evaluate", " ", "the", " ", "model"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"msePoly", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"yTest", "-", "predictionsPoly"}], ")"}], "^", "2"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"rmsePoly", "=", 
     RowBox[{"Sqrt", "[", "msePoly", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rSquaredPoly", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"yTest", "-", "predictionsPoly"}], ")"}], "^", "2"}], "]"}],
        "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"yTest", "-", 
           RowBox[{"Mean", "[", "yTest", "]"}]}], ")"}], "^", "2"}], 
        "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Training examples: \>\"", ",", 
      RowBox[{"Length", "[", "xTrainPoly", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Testing examples: \>\"", ",", 
      RowBox[{"Length", "[", "xTestPoly", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of features: \>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"First", "[", "xTrainPoly", "]"}], "]"}], "-", "1"}]}], "]"}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mean Squared Error: \>\"", ",", "msePoly"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Root Mean Squared Error: \>\"", ",", "rmsePoly"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<R Squared: \>\"", ",", "rSquaredPoly"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Display", " ", "first", " ", "10", " ", "actual", " ", "and", " ", 
     "predicted", " ", "prices"}], "*)"}], "\n", 
   RowBox[{"Take", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"yTest", ",", "predictionsPoly"}], "}"}], "]"}], ",", "10"}], 
    "]"}], "\n"}]}]], "Input",
