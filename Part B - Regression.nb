       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"testHeaders", ",", "#"}], "]"}], "&"}], "/@", "features"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"priceColumn", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"trainHeaders", ",", "\"\<SalePrice\>\""}], "]"}], "]"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"idColumn", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"testHeaders", ",", "\"\<Id\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Prepare", " ", "training", " ", "data"}], "*)"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"validNumber", "[", "value_", "]"}], ":=", 
     RowBox[{"NumberQ", "[", "value", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"trainingRows", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"trainRows", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"validNumber", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "priceColumn", "]"}], "]"}], "]"}], "&&", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "featureColumns", "]"}], "]"}], ",", "validNumber"}],
           "]"}]}], "&"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"N", "[", 
      RowBox[{"trainingRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "featureColumns"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{"N", "[", 
      RowBox[{"trainingRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "priceColumn"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"Length", "[", "x", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{
      RowBox[{"Length", "[", "features", "]"}], "+", "1"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Add", " ", "the", " ", "dummy", " ", "column", " ", "of", " ", "1", 
     "s"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "x"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Training examples: \>\"", ",", "m"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of parameters: \>\"", ",", "n"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Input dimensions: \>\"", ",", 
      RowBox[{"Dimensions", "[", "x", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Calculate", " ", "regression", " ", "parameters"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"LeastSquares", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theta values: \>\"", ",", "theta"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Prepare", " ", "test", " ", "data"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testX", "=", 
     RowBox[{"N", "[", 
      RowBox[{"testRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "testColumns"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Replace", " ", "missing", " ", "test", " ", "values", " ", "with", " ", 
     "training", " ", "means"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"means", "=", 
     RowBox[{"Mean", "/@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"trainingRows", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "featureColumns"}], "]"}], "]"}], "]"}]}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testX", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumberQ", "[", "#1", "]"}], ",", "#1", ",", "#2"}], 
            "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"#", ",", "means"}], "}"}]}], "]"}], "&"}], ",", "testX"}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testX", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "testX"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "Predict", " ", "house", " ", "prices"}], "*)"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"predictedPrices", "=", 
     RowBox[{"testX", ".", "theta"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"predictedPrices", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"#", ",", "0.01"}], "]"}], "&"}], "/@", "predictedPrices"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "7.", " ", "Match", " ", "each", " ", "prediction", " ", "with", " ", 
     "its", " ", "house", " ", "ID"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ids", "=", 
     RowBox[{"testRows", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "idColumn"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"answer", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ids", ",", "predictedPrices"}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<id\>\"", ",", "\"\<price\>\""}], "}"}]}], "]"}]}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total predictions: \>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "answer", "]"}], "-", "1"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "first", " ", "10", " ", "predictions"}], "*)"}], 
   "\n", 
   RowBox[{"Take", "[", 
    RowBox[{"answer", ",", "11"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "all", " ", "predictions"}], "*)"}], "\n", 
   "answer", "\n"}]}]], "Input",
