Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Predict", " ", "prices", " ", "for", " ", "the", " ", "training", " ", 
    "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"trainingPredictions", "=", 
     RowBox[{"x", ".", "theta"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "Mean", " ", "Squared", " ", "Error"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mse", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"y", "-", "trainingPredictions"}], ")"}], "^", "2"}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "Root", " ", "Mean", " ", "Squared", " ", "Error"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rmse", "=", 
     RowBox[{"Sqrt", "[", "mse", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "R", " ", "Squared"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rSquared", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", "trainingPredictions"}], ")"}], "^", "2"}], "]"}],
        "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"Mean", "[", "y", "]"}]}], ")"}], "^", "2"}], "]"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Mean Squared Error: \>\"", ",", "mse"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Root Mean Squared Error: \>\"", ",", "rmse"}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<R Squared: \>\"", ",", "rSquared"}], "]"}], ";"}], 
   "\n"}]}]], "Input",
