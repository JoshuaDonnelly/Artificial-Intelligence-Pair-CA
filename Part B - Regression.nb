Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Question", " ", "3"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Import", " ", "training", " ", "and", " ", "testing", " ", 
    "data"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"trainData", "=", 
     RowBox[{
     "Import", 
      "[", "\"\<C:\\\\Users\\\\dylan\\\\Downloads\\\\archive\\\\train.csv\>\"",
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"testData", "=", 
     RowBox[{
     "Import", 
      "[", "\"\<C:\\\\Users\\\\dylan\\\\Downloads\\\\archive\\\\test.csv\>\"",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"trainHeaders", "=", 
     RowBox[{"First", "[", "trainData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"testHeaders", "=", 
     RowBox[{"First", "[", "testData", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"trainRows", "=", 
     RowBox[{"Rest", "[", "trainData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"testRows", "=", 
     RowBox[{"Rest", "[", "testData", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"2.", " ", "Select", " ", "the", " ", "house", " ", "features"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"features", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<OverallQual\>\"", ",", "\"\<GrLivArea\>\"", 
       ",", "\"\<GarageCars\>\"", ",", "\"\<TotalBsmtSF\>\"", 
       ",", "\"\<FullBath\>\"", ",", "\"\<YearBuilt\>\"", 
       ",", "\"\<1stFlrSF\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"featureColumns", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"trainHeaders", ",", "#"}], "]"}], "&"}], "/@", "features"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"testColumns", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{"testHeaders", ",", "#"}], "]"}], "&"}], "/@", "features"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"priceColumn", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"trainHeaders", ",", "\"\<SalePrice\>\""}], "]"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"idColumn", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"testHeaders", ",", "\"\<Id\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "Prepare", " ", "training", " ", "data"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"validNumber", "[", "value_", "]"}], ":=", 
     RowBox[{"NumberQ", "[", "value", "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"trainingRows", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"trainRows", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"validNumber", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "priceColumn", "]"}], "]"}], "]"}], "&&", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "featureColumns", "]"}], "]"}], ",", "validNumber"}],
           "]"}]}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"N", "[", 
      RowBox[{"trainingRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "featureColumns"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{"N", "[", 
      RowBox[{"trainingRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "priceColumn"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"Length", "[", "x", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{
      RowBox[{"Length", "[", "features", "]"}], "+", "1"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Add", " ", "the", " ", "dummy", " ", "column", " ", "of", " ", "1", 
     "s"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "x"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Training examples: \>\"", ",", "m"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of parameters: \>\"", ",", "n"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Input dimensions: \>\"", ",", 
      RowBox[{"Dimensions", "[", "x", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"4.", " ", "Calculate", " ", "regression", " ", "parameters"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"LeastSquares", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Theta values: \>\"", ",", "theta"}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Prepare", " ", "test", " ", "data"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testX", "=", 
     RowBox[{"N", "[", 
      RowBox[{"testRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "testColumns"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Replace", " ", "missing", " ", "test", " ", "values", " ", "with", " ", 
     "training", " ", "means"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"means", "=", 
     RowBox[{"Mean", "/@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"trainingRows", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "featureColumns"}], "]"}], "]"}], "]"}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"testX", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"NumberQ", "[", "#1", "]"}], ",", "#1", ",", "#2"}], 
            "]"}], "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"#", ",", "means"}], "}"}]}], "]"}], "&"}], ",", "testX"}],
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"testX", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "testX"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"6.", " ", "Predict", " ", "house", " ", "prices"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"predictedPrices", "=", 
     RowBox[{"testX", ".", "theta"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"predictedPrices", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Round", "[", 
        RowBox[{"#", ",", "0.01"}], "]"}], "&"}], "/@", "predictedPrices"}]}],
     ";"}], "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "7.", " ", "Match", " ", "each", " ", "prediction", " ", "with", " ", 
     "its", " ", "house", " ", "ID"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ids", "=", 
     RowBox[{"testRows", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "idColumn"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"answer", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ids", ",", "predictedPrices"}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<id\>\"", ",", "\"\<price\>\""}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total predictions: \>\"", ",", 
      RowBox[{
       RowBox[{"Length", "[", "answer", "]"}], "-", "1"}]}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "first", " ", "10", " ", "predictions"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Take", "[", 
    RowBox[{"answer", ",", "11"}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "all", " ", "predictions"}], "*)"}], "\[IndentingNewLine]",
    "answer", "\n"}]}]], "Input",
