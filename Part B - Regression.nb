Cell["Question 6", "Text",
 CellChangeTimes->{{4.0041908278611813`*^9, 
  4.0041908311138535`*^9}},ExpressionUUID->"f4370364-41c5-8945-a3dc-\
19d3637262a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Polynomial", " ", "Regression", " ", "using", " ", "Gradient", " ", 
    "Descent"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Use", " ", "existing", " ", "polynomial", " ", "data"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xPolyTrain", "=", 
     RowBox[{"N", "[", "xPolyTrain", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"yPolyTrain", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"N", "[", "yPolyTrain", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"Length", "[", "yPolyTrain", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Cost", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polyCost", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"xPolyTrain", ".", "t"}], "-", "yPolyTrain"}], ")"}], "^", 
        "2"}], "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "m"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Gradient", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polyGradient", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Transpose", "[", "xPolyTrain", "]"}], ".", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"xPolyTrain", ".", "t"}], "-", "yPolyTrain"}], ")"}]}], "/", 
      "m"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Initial", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetaPoly", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{
        RowBox[{"Dimensions", "[", "xPolyTrain", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Settings", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaPoly", "=", "0.01"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"tolerance", "=", "0.000001"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"maxIterations", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"oldCost", "=", 
     RowBox[{"polyCost", "[", "thetaPoly", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"iteration", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"converged", "=", "False"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Gradient", " ", "Descent"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"While", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"iteration", "<", "maxIterations"}], "&&", 
       RowBox[{"!", "converged"}]}], ",", 
      RowBox[{
       RowBox[{"gradient", "=", 
        RowBox[{"polyGradient", "[", "thetaPoly", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"newTheta", "=", 
        RowBox[{"thetaPoly", "-", 
         RowBox[{"alphaPoly", " ", "gradient"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"newCost", "=", 
        RowBox[{"polyCost", "[", "newTheta", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Reduce", " ", "learning", " ", "rate", " ", "if", " ", "cost", " ", 
         "increases"}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"newCost", ">", "oldCost"}], ",", 
         RowBox[{"alphaPoly", "=", 
          RowBox[{"alphaPoly", "/", "2"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{"Accept", " ", "the", " ", "new", " ", "parameters"}], 
          "*)"}], 
         RowBox[{
          RowBox[{"improvement", "=", 
           RowBox[{"oldCost", "-", "newCost"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"thetaPoly", "=", "newTheta"}], ";", "\[IndentingNewLine]", 
          RowBox[{"iteration", "++"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "improvement", "]"}], "<", "tolerance"}], 
            ",", 
            RowBox[{"converged", "=", "True"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"oldCost", "=", "newCost"}], ";"}]}], "]"}], ";"}]}], "]"}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Iterations used: \>\"", ",", "iteration"}], "]"}], ";"}], 
