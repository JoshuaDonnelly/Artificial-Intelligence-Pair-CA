Cell["Question 7", "Text",
 CellChangeTimes->{{4.004196789415943*^9, 
  4.0041967915070705`*^9}},ExpressionUUID->"5e55c5b2-5d51-d94e-8de1-\
a515b0a1acae"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"testData", "=", 
     RowBox[{
     "Import", 
      "[", "\"\<C:\\\\Users\\\\dylan\\\\Downloads\\\\archive\\\\test.csv\>\"",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Get", " ", "headers", " ", "and", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testHeaders", "=", 
     RowBox[{"First", "[", "testData", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"testRows", "=", 
     RowBox[{"Rest", "[", "testData", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Select", " ", "the", " ", "same", " ", "features", " ", "as", " ", 
     "Question", " ", "5"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testColumns", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{"testHeaders", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
      "featureNames"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNew", "=", 
     RowBox[{"N", "[", 
      RowBox[{"testRows", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"Flatten", "[", "testColumns", "]"}]}], "]"}], "]"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Normalize", " ", "using", " ", "Question", " ", "5", " ", "training", " ",
      "values"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNewScaled", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", "featureMeans"}], ")"}], "/", "featureSDs"}], 
        "&"}], ",", "xNew"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "polynomial", " ", "features"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNewPoly", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"#", ",", 
            RowBox[{"#", "^", "2"}]}], "]"}], ",", "1"}], "]"}], "&"}], ",", 
       "xNewScaled"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Predict", " ", "using", " ", "Gradient", " ", "Descent", " ", 
     "parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "regression", " ", "hypothesis"}], 
    "*)"}], 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"xInput_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"xInput", ".", "t"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Predict", " ", "house", " ", "prices"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"predictedPrices", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{"#", ",", "thetaGD"}], "]"}], "&"}], ",", "xNewPoly"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Get", " ", "house", " ", "IDs"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"idColumn", "=", 
     RowBox[{"First", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Position", "[", 
        RowBox[{"testHeaders", ",", "\"\<Id\>\""}], "]"}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"houseIDs", "=", 
     RowBox[{"testRows", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "idColumn"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "predictions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"resultsQ7", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"houseIDs", ",", "predictedPrices"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of predictions: \>\"", ",", 
      RowBox[{"Length", "[", "predictedPrices", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Take", "[", 
        RowBox[{"resultsQ7", ",", "20"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<House ID\>\"", ",", "\"\<Predicted Price\>\""}], "}"}]}],
       "]"}], ",", 
     RowBox[{"Frame", "->", "All"}]}], "]"}], "\n"}]}]], "Input",
