Cell["Question 6", "Text",
 CellChangeTimes->{{4.0041908278611813`*^9, 
  4.0041908311138535`*^9}},ExpressionUUID->"f4370364-41c5-8945-a3dc-\
19d3637262a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "h", ",", "costJ", ",", "gradJ", ",", "thetaCurr", ",", "costs", ",", 
     "alpha", ",", "step"}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Use", " ", "training", " ", "data", " ", "from", " ", 
    "Question", " ", "5"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"xGD", "=", 
   RowBox[{"N", "[", "xTrainPoly", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"yGD", "=", 
    RowBox[{"N", "[", "yTrain", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mGD", ",", "nGD"}], "}"}], "=", 
    RowBox[{"Dimensions", "[", "xGD", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", "Normalize", " ", "the", " ", "data"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"polyMeans", "=", 
   RowBox[{"Mean", "/@", 
    RowBox[{"Transpose", "[", 
     RowBox[{"xGD", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"polySDs", "=", 
   RowBox[{"StandardDeviation", "/@", 
    RowBox[{"Transpose", "[", 
     RowBox[{"xGD", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;"}]}], "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"polySDs", "=", 
    RowBox[{"polySDs", "/.", " ", 
     RowBox[{"0.", "->", "1."}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "-", "polyMeans"}], ")"}], "/", "polySDs"}], ",", 
         "1"}], "]"}], "&"}], ",", 
      RowBox[{"xGD", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"2", ";;"}]}], "]"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"yMean", "=", 
   RowBox[{"Mean", "[", "yGD", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ySD", "=", 
   RowBox[{"StandardDeviation", "[", "yGD", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"y", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"yGD", "-", "yMean"}], ")"}], "/", "ySD"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"3.", " ", "Define", " ", "hypothesis"}], ",", 
    RowBox[{"cost", " ", "and", " ", "gradient"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"xInput_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"xInput", ".", "t"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"costJ", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"#", ",", "t"}], "]"}], "&"}], ",", "x"}], "]"}], "-", 
         "y"}], ")"}], "^", "2"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "mGD"}], ")"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradJ", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Transpose", "[", "x", "]"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"#", ",", "t"}], "]"}], "&"}], ",", "x"}], "]"}], "-", 
        "y"}], ")"}]}], "/", "mGD"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Set", " ", "learning", " ", "rate", " ", "and", " ", 
    "starting", " ", "parameters"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"alpha", "=", 
    RowBox[{"1.", "/", 
     RowBox[{"Max", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", "x", "]"}], ".", "x"}], "/", "mGD"}], 
       "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"thetaCurr", "=", 
    RowBox[{"Table", "[", 
     RowBox[{"0.", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nGD"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Learning Rate: \>\"", ",", "alpha"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Initial Theta: \>\"", ",", 
     RowBox[{"MatrixForm", "[", "thetaCurr", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"5.", " ", "Apply", " ", "Gradient", " ", "Descent"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"costs", "=", 
    RowBox[{"{", 
     RowBox[{"costJ", "[", "thetaCurr", "]"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"step", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxIterations", "=", "20000"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"While", "[", 
    RowBox[{
     RowBox[{"step", "<", "maxIterations"}], ",", 
     RowBox[{
      RowBox[{"thetaCurr", "=", 
       RowBox[{"thetaCurr", "-", 
        RowBox[{"alpha", " ", 
         RowBox[{"gradJ", "[", "thetaCurr", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"costs", ",", 
        RowBox[{"costJ", "[", "thetaCurr", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"step", "++"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"costs", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "-", 
           RowBox[{"costs", "[", 
            RowBox[{"[", 
             RowBox[{"-", "2"}], "]"}], "]"}]}], "]"}], "<", 
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}]}], ",", 
        RowBox[{"Break", "[", "]"}]}], "]"}], ";"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "6.", " ", "Display", " ", "iterations", " ", "and", " ", "cost", " ", 
    "graph"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Iterations: \>\"", ",", "step"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Final Normalized Cost: \>\"", ",", 
     RowBox[{"Last", "[", "costs", "]"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"costs", ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Iteration\>\"", ",", "\"\<Cost\>\""}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Gradient Descent Cost\>\""}]}], "]"}], 
    "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "7.", " ", "Convert", " ", "parameters", " ", "back", " ", "to", " ", 
    "Question", " ", "5", " ", "scale"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coeffGD", "=", 
    RowBox[{"ySD", " ", 
     RowBox[{
      RowBox[{"Rest", "[", "thetaCurr", "]"}], "/", "polySDs"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"thetaGD", "=", 
    RowBox[{"Prepend", "[", 
     RowBox[{"coeffGD", ",", 
      RowBox[{"yMean", "+", 
       RowBox[{"ySD", " ", 
        RowBox[{"First", "[", "thetaCurr", "]"}]}], "-", 
       RowBox[{"Total", "[", 
        RowBox[{"coeffGD", " ", "polyMeans"}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"8.", " ", "Display", " ", "final", " ", "results"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Gradient Descent Parameters: \>\"", ",", "thetaGD"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<Final Cost: \>\"", ",", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"xGD", ".", "thetaGD"}], "-", "yGD"}], ")"}], "^", "2"}], 
