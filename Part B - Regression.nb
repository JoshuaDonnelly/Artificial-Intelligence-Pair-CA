Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Use", " ", "the", " ", "test", " ", "features", " ", "from", " ", 
    "Question", " ", "3"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xNewScaled", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "-", "means"}], ")"}], "/", "stds"}], "&"}], "/@", 
       "xTestFeatures"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "polynomial", " ", "features", " ", "using", " ", 
     "Question", " ", "5", " ", "method"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"xNewPoly", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{"#", ",", 
            RowBox[{"#", "^", "2"}]}], "]"}], ",", "1"}], "]"}], "&"}], ",", 
       "xNewScaled"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Use", " ", "the", " ", "trained", " ", "model", " ", "from", " ", 
     "Question", " ", "6"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyPredictions", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"N", "[", "xNewPoly", "]"}], ".", "thetaPoly"}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Get", " ", "house", " ", "IDs", " ", "from", " ", 
     RowBox[{"test", ".", "csv"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ids", "=", 
     RowBox[{"testRows", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "predicted", " ", "prices"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"answer7", "=", 
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"ids", ",", 
          RowBox[{"Round", "[", 
           RowBox[{"polyPredictions", ",", "0.01"}], "]"}]}], "}"}], "]"}], 
       ",", 
       RowBox[{"{", 
        RowBox[{"\"\<id\>\"", ",", "\"\<price\>\""}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"MatrixForm", "[", 
      RowBox[{"Take", "[", 
       RowBox[{"answer7", ",", "11"}], "]"}], "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", "\n", "\n"}]}]], "Input",
