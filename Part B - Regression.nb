Cell["Question 8", "Text",
 CellChangeTimes->{{4.0041983884595146`*^9, 
  4.0041983919394836`*^9}},ExpressionUUID->"7a6b8c65-c787-0e4c-9e5b-\
ee324e76dac5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Use", " ", "the", " ", "same", " ", "validation", " ", "houses", " ", 
    "for", " ", "both", " ", "models"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xLinearValidation", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"x", ",", 
       RowBox[{"-", 
        RowBox[{"Length", "[", "yPolyValidation", "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Linear", " ", "model", " ", "predictions", " ", "from", " ", "Question", 
     " ", "2"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"linearValidationPredictions", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"xLinearValidation", ".", "\[Theta]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Non", "-", 
     RowBox[{
     "linear", " ", "model", " ", "predictions", " ", "from", " ", "Question",
       " ", "6"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"polyValidationPredictions", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"N", "[", "xPolyValidation", "]"}], ".", "thetaPoly"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Actual", " ", "house", " ", "prices"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"actualPrices", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"N", "[", "yPolyValidation", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "errors"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"linearErrors8", "=", 
     RowBox[{"actualPrices", "-", "linearValidationPredictions"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"polyErrors8", "=", 
     RowBox[{"actualPrices", "-", "polyValidationPredictions"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "MSE"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearMSE", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"linearErrors8", "^", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"polyMSE", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"polyErrors8", "^", "2"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "RMSE"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearRMSE8", "=", 
     RowBox[{"Sqrt", "[", "linearMSE", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"polyRMSE8", "=", 
     RowBox[{"Sqrt", "[", "polyMSE", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "R", " ", "Squared"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"linearR2", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"linearErrors8", "^", "2"}], "]"}], "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"actualPrices", "-", 
           RowBox[{"Mean", "[", "actualPrices", "]"}]}], ")"}], "^", "2"}], 
        "]"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyR2", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"polyErrors8", "^", "2"}], "]"}], "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"actualPrices", "-", 
           RowBox[{"Mean", "[", "actualPrices", "]"}]}], ")"}], "^", "2"}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "results"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Linear MSE: \>\"", ",", 
      RowBox[{"N", "[", "linearMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Linear RMSE: \>\"", ",", 
      RowBox[{"N", "[", "linearRMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Linear R Squared: \>\"", ",", 
      RowBox[{"N", "[", "linearR2", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Non-Linear MSE: \>\"", ",", 
      RowBox[{"N", "[", "polyMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Non-Linear RMSE: \>\"", ",", 
      RowBox[{"N", "[", "polyRMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Non-Linear R Squared: \>\"", ",", 
      RowBox[{"N", "[", "polyR2", "]"}]}], "]"}], ";"}], "\n"}]}]], "Input",
