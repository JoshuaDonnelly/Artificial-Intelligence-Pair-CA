    RowBox[{"rSquared", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", "trainingPredictions"}], ")"}], "^", "2"}], "]"}],
        "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"y", "-", 
           RowBox[{"Mean", "[", "y", "]"}]}], ")"}], "^", "2"}], "]"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
