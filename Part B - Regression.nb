Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Use", " ", "the", " ", "same", " ", "validation", " ", "houses", " ", 
    "for", " ", "both", " ", "models"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xLinearValidation", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"x", ",", 
       RowBox[{"-", 
        RowBox[{"Length", "[", "yPolyValidation", "]"}]}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Linear", " ", "model", " ", "predictions", " ", "from", " ", "Question", 
     " ", "2"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearValidationPredictions", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"xLinearValidation", ".", "\[Theta]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Non", "-", 
     RowBox[{
     "linear", " ", "model", " ", "predictions", " ", "from", " ", "Question",
       " ", "6"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"polyValidationPredictions", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"N", "[", "xPolyValidation", "]"}], ".", "thetaPoly"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Actual", " ", "house", " ", "prices"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actualPrices", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"N", "[", "yPolyValidation", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "errors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearErrors", "=", 
     RowBox[{"actualPrices", "-", "linearValidationPredictions"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"polyErrors", "=", 
     RowBox[{"actualPrices", "-", "polyValidationPredictions"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "MSE"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"linearMSE", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"linearErrors", "^", "2"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"polyMSE", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{"polyErrors", "^", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "RMSE"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearRMSE", "=", 
     RowBox[{"Sqrt", "[", "linearMSE", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"polyRMSE", "=", 
     RowBox[{"Sqrt", "[", "polyMSE", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "R", " ", "Squared"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"linearR2", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"linearErrors", "^", "2"}], "]"}], "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"actualPrices", "-", 
           RowBox[{"Mean", "[", "actualPrices", "]"}]}], ")"}], "^", "2"}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"polyR2", "=", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"polyErrors", "^", "2"}], "]"}], "/", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"actualPrices", "-", 
           RowBox[{"Mean", "[", "actualPrices", "]"}]}], ")"}], "^", "2"}], 
        "]"}]}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "results"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Linear MSE: \>\"", ",", 
      RowBox[{"N", "[", "linearMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Linear RMSE: \>\"", ",", 
      RowBox[{"N", "[", "linearRMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Linear R Squared: \>\"", ",", 
      RowBox[{"N", "[", "linearR2", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Non-Linear MSE: \>\"", ",", 
      RowBox[{"N", "[", "polyMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Non-Linear RMSE: \>\"", ",", 
      RowBox[{"N", "[", "polyRMSE", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Non-Linear R Squared: \>\"", ",", 
      RowBox[{"N", "[", "polyR2", "]"}]}], "]"}], ";"}], "\n", 
   "\n"}]}]], "Input",
