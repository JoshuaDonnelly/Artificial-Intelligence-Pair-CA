  RowBox[{
   RowBox[{
    RowBox[{"trainingPredictions", "=", 
     RowBox[{"x", ".", "theta"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "Mean", " ", "Squared", " ", "Error"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mse", "=", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"y", "-", "trainingPredictions"}], ")"}], "^", "2"}], "]"}]}],
     ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "Root", " ", "Mean", " ", "Squared", " ", "Error"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rmse", "=", 
     RowBox[{"Sqrt", "[", "mse", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "R", " ", "Squared"}], "*)"}], "\[IndentingNewLine]", 
